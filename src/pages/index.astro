---
// Gerado a partir de: casamentos.html (Página principal)
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import WhatsAppModal from '../components/layout/WhatsAppModal.astro';
import '../styles/casamentos.css';

const waStep1Fields = [
  { name: 'tipo_evento', type: 'select', label: 'Tipo de Evento', required: true, options: [
    { value: '', label: 'Selecione o tipo de evento', disabled: true, selected: true },
    { value: 'bodas', label: 'Bodas' },
    { value: 'casamento', label: 'Casamento' },
    { value: 'confraternizacao', label: 'Confraternização social' },
    { value: 'outros', label: 'Outros' },
  ]},
  { name: 'convidados', type: 'number', label: 'Número de Convidados', min: '1', required: true },
  { name: 'data_prevista', type: 'date', label: 'Data Prevista', required: true, min: '2024-01-01' },
  { name: 'mensagem', type: 'textarea', label: 'Mensagem (Opcional)', required: false, rows: 3, placeholder: 'Conte-nos um pouco sobre como imagina o seu dia especial...' },
];
---

<Base
  title="Espaço Mares | Casamentos vista-mar em Ilhabela"
  description="Viva seu grande dia diante do mar de Ilhabela. Espaço Mares, integrado ao Mares Ilha Mall, é o cenário perfeito para o seu casamento."
  ogImage="https://media.dmove.com.br/clients/mares-ilha-bela/photos/perfil.webp"
>
<!-- ===================== HEADER ===================== -->
<header id="site-header">
  <div class="wrap">
    <nav class="main-nav main-nav-left">
      <a href="#sobre">Sobre</a>
      <a href="#cerimonia">Cerimônia</a>
      <a href="#salao">Salão</a>
    </nav>
    <a href="#topo" class="logo-mark">
      <Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/logo-white_resultado.webp" alt="Espaço Mares" class="logo-white" priority />
      <Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/logo_resultado.webp" alt="Espaço Mares" class="logo-navy" />
    </a>
    <nav class="main-nav main-nav-right">
      <a href="#infra">Estrutura</a>
      <a href="#galeria">Galeria</a>
      <a href="#local">Localização</a>
    </nav>
    <button class="burger" id="burger" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobileNav">
  <a href="#sobre">Sobre</a>
  <a href="#cerimonia">Cerimônia</a>
  <a href="#salao">Salão</a>
  <a href="#infra">Estrutura</a>
  <a href="#galeria">Galeria</a>
  <a href="#local">Localização</a>
  <a href="#contato" class="btn gold">Comece a planejar</a>
</div>

<!-- ===================== HERO ===================== -->
<section class="hero" id="topo">
  <Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/hero_casamentos_resultado.webp" alt="Noiva com vestido de renda em terraço à beira-mar em Ilhabela" class="bg" />
  <div class="wrap">
    <h1>O mar de Ilhabela<br>como convidado<br><em>do seu casamento.</em></h1>
    <p class="lead">Viva seu grande dia diante de<br class="mobile-only"> um horizonte<br class="desktop-only"> que só o litoral norte<br class="mobile-only"> pode oferecer.</p>
    <span class="eyebrow">Ilhabela - SP | Casamentos vista-mar</span>
    <div class="hero-actions">
      <a href="#contato" class="btn gold">Comece a planejar</a>
    </div>
  </div>
</section>

<!-- ===================== SOBRE ===================== -->
<section id="sobre" class="reveal">
  <div class="wrap split">
    <div class="split-media frame">
      <Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/sobre_casamentos_resultado.webp" alt="Espaço Mares em Ilhabela com vista para o mar" />
    </div>
    <div class="split-text">
      <h1>Criado em Ilhabela,<br>feito para o seu<br><em>casamento</em></h1>
      <p style="margin-top:22px;">Integrado ao Mares Ilha Mall, o Espaço Mares abre as portas para casais que querem ter o mar como plano de fundo do seu casamento. Aqui você tem liberdade para montar os cenários do seu jeito e transformar cada detalhe na festa que você sempre sonhou, com o horizonte da ilha como testemunha de cada momento.</p>
    </div>
  </div>
</section>

<!-- ===================== CERIMÔNIA ===================== -->
<section id="cerimonia" class="reveal">
  <div class="wrap split reverse">
    <div class="split-text">
      <h1>O início de uma nova<br>história diante da<br><em>imensidão do mar</em></h1>
      <p style="margin-top:22px;">Troque o tradicional por um altar cercado pela beleza natural que acompanha cada um dos seus votos.</p>
      <a href="#contato" class="btn gold" style="margin-top:22px;">Comece a planejar</a>
    </div>
    <div class="split-media frame">
      <Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/cerimonia_casamentos_resultado.webp" alt="Altar de cerimônia com vista para o mar em Ilhabela" />
    </div>
  </div>
</section>

<!-- ===================== SALÃO ===================== -->
<section id="salao" class="reveal">
  <div class="wrap">
    <div class="center-head">
      <h2>Um ambiente que une<br><em>elegância e praticidade</em></h2>
      <p class="lead" style="margin:20px auto 0;">Cada cenário do Espaço Mares foi desenhado para transformar sua festa em uma celebração inesquecível.</p>
    </div>
    <div class="salao-grid">
      <div class="g1"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/ambiente_casamentos01_resultado.webp" alt="Salão do Espaço Mares em Ilhabela" /></div>
      <div class="g2"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/ambiente_casamentos02_resultado.webp" alt="Área de estar do Espaço Mares decorada com flores" /></div>
      <div class="g3"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/ambiente_casamentos03_resultado.webp" alt="Lounge coberto do Espaço Mares com vista para o mar" /></div>
    </div>
  </div>
</section>

<!-- ===================== INFRAESTRUTURA ===================== -->
<section id="infra" class="reveal">
  <div class="wrap">
    <div class="center-head">
      <h1>Cuidamos de tudo<br>para que seu evento<br><em>seja perfeito</em></h1>
      <p class="lead" style="margin:20px auto 0;">Infraestrutura pensada para trazer conforto aos convidados.</p>
    </div>

    <div class="infra-list">
      <div class="infra-item">
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.4"/></svg></div>
        <div>
          <h3>Localização privilegiada</h3>
          <p>Dentro do Mares Ilha Mall, a 1 km da balsa.</p>
        </div>
      </div>
      <div class="infra-item">
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16v3a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-1h10v1a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-3"/><path d="M4 16 5.4 9.6A2 2 0 0 1 7.3 8h9.4a2 2 0 0 1 1.9 1.6L20 16"/><path d="M4 16h16"/><circle cx="7.5" cy="16" r="1"/><circle cx="16.5" cy="16" r="1"/></svg></div>
        <div>
          <h3>Estacionamento próprio</h3>
          <p>Chegada tranquila para você e seus convidados.</p>
        </div>
      </div>
      <div class="infra-item">
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4"/><path d="M3 12h18v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3Z"/><path d="M4 16v3M20 16v3"/></svg></div>
        <div>
          <h3>Mobiliário próprio</h3>
          <p>Praticidade na hora de montar cada cenário.</p>
        </div>
      </div>
      <div class="infra-item">
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17.5c0-4.7 4-8.5 9-8.5s9 3.8 9 8.5"/><path d="M2.5 17.5h19"/><path d="M12 9V6"/><circle cx="12" cy="5" r="1.1"/></svg></div>
        <div>
          <h3>Rede de parceiros</h3>
          <p>Buffet, decoração, som e iluminação, à sua escolha.</p>
        </div>
      </div>
      <div class="infra-item">
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 11.5 12 4l8.5 7.5"/><path d="M5.5 10v9.5h13V10"/><path d="M10 19.5V14h4v5.5"/></svg></div>
        <div>
          <h3>Hotéis próximos</h3>
          <p>Hospedagem a poucos passos do espaço.</p>
        </div>
      </div>
      <div class="infra-item">
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 14c1.5 1.4 3 1.4 4.5 0s3-1.4 4.5 0 3 1.4 4.5 0 3-1.4 4.5 0"/><path d="M2.5 18.5c1.5 1.4 3 1.4 4.5 0s3-1.4 4.5 0 3 1.4 4.5 0 3-1.4 4.5 0"/></svg></div>
        <div>
          <h3>Píer do complexo</h3>
          <p>Um cenário diferente para fotos inesquecíveis.</p>
        </div>
      </div>
    </div>

    <div class="center-head" style="margin-top:40px;">
      <a href="#contato" class="btn gold">Comece a planejar</a>
    </div>
  </div>
</section>

<!-- ===================== PARALLAX ===================== -->
<div class="parallax-section" aria-label="Vista do Espaço Mares"></div>

<!-- ===================== GALERIA ===================== -->
<section id="galeria" class="reveal">
  <div class="wrap">
    <div class="center-head">
      <h2>Inspire-se para<br><em>o seu casamento</em></h2>
      <p class="lead" style="margin:20px auto 0;">Um vislumbre de momentos que já aconteceram de frente para o mar, no Espaço Mares.</p>
    </div>
    <div class="mosaic-grid" id="galeriaGrid">
      <div class="mosaic-block block-a">
        <div class="g-item"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/galeria_casamentos08_resultado.webp" alt="Espaço Mares - Casamento em Ilhabela" /></div>
        <div class="g-item"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/galeria_casamentos07_resultado.webp" alt="Espaço Mares - Casamento em Ilhabela" /></div>
        <div class="g-item"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/galeria_casamentos05_resultado.webp" alt="Espaço Mares - Casamento em Ilhabela" /></div>
        <div class="g-item"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/galeria_casamentos04_resultado.webp" alt="Espaço Mares - Casamento em Ilhabela" /></div>
      </div>
      <div class="mosaic-block block-b">
        <div class="g-item"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/galeria_casamentos03_resultado.webp" alt="Espaço Mares - Casamento em Ilhabela" /></div>
        <div class="g-item"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/galeria_casamentos02_resultado.webp" alt="Espaço Mares - Casamento em Ilhabela" /></div>
        <div class="g-item"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/galeria_casamentos06_resultado.webp" alt="Espaço Mares - Casamento em Ilhabela" /></div>
        <div class="g-item"><Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/galeria_casamentos01_resultado-v2.webp" alt="Espaço Mares - Casamento em Ilhabela" /></div>
      </div>
    </div>
  </div>
</section>

<div class="lightbox" id="lightbox">
  <button class="lb-close" id="lbClose">&times;</button>
  <button class="lb-arrow lb-prev" id="lbPrev">&#8249;</button>
  <img src="" alt="" id="lbImg" />
  <button class="lb-arrow lb-next" id="lbNext">&#8250;</button>
  <span class="lb-count" id="lbCount"></span>
</div>

<!-- ===================== CONTATO ===================== -->
<section id="contato" class="reveal">
  <Img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/contato-bg.webp" alt="Ilhabela vista do alto, praia e mata" class="bg" width={1920} height={1080} />
  <div class="wrap contato-grid">
    <div class="contato-info">
      <h1>Vamos celebrar<br>juntos o seu<br><em>casamento?</em></h1>
      <p class="lead" style="margin-top:18px;">Preencha o formulário para receber nosso contato.</p>

      <div class="contact-line">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.4"/></svg>
        <span>Mares Ilha Mall — Ilhabela, SP</span>
      </div>
    </div>

    <div class="contato-form">
      <LeadForm
        formId="lead-form"
        prefix="wedding"
        project={config.project_slug}
        submitUrl={config.forms['lead-form'].webhooks[0]}
        redirectUrl={config.forms['lead-form'].redirect_on_success}
        submitText="Enviar solicitação"
        honeypot
        fields={[
          { name: 'nome', type: 'text', label: 'Nome', required: true, full: true },
          { name: 'telefone', type: 'tel', label: 'Telefone', required: true },
          { name: 'email', type: 'email', label: 'E-mail', required: true },
          { name: 'data', type: 'date', label: 'Data do evento', required: false },
          { name: 'pessoas', type: 'number', label: 'Número de pessoas', min: '1', required: false },
          { name: 'tipo', type: 'select', label: 'Tipo de evento', required: false, full: true, options: [
            { value: '', label: 'Selecione' },
            { value: 'Bodas', label: 'Bodas' },
            { value: 'Casamento', label: 'Casamento' },
            { value: 'Confraternização social', label: 'Confraternização social' },
            { value: 'Outros', label: 'Outros' }
          ] },
          { name: 'detalhes', type: 'textarea', label: 'Detalhes adicionais', rows: 4, required: false, full: true }
        ]}
      />
    </div>
  </div>
</section>

<!-- ===================== LOCALIZAÇÃO ===================== -->
<section id="local" class="bg-cream reveal">
  <div class="wrap">
    <div class="center-head" style="margin-bottom:56px;">
      <h2>Fácil acesso,<br><em>hospedagem por perto</em></h2>
    </div>
    <div class="local-grid">
      <div class="map-frame">
        <iframe src="https://www.google.com/maps?q=Mares+Ilha+Mall,+Ilhabela+SP&output=embed" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade" title="Mapa do Espaço Mares em Ilhabela"></iframe>
      </div>
      <div class="hotels">
        <h3>Hotéis próximos</h3>

        <div class="hotel">
          <div>
            <div class="h-name">Pousada Bons Ventos</div>
            <div class="h-addr">R. Benedito Serafim Sampaio, 371 — Praia do Perequê, Ilhabela - SP, 11630-000</div>
          </div>
          <div class="h-dist">200 m</div>
        </div>

        <div class="hotel">
          <div>
            <div class="h-name">Pousada Vila das Velas</div>
            <div class="h-addr">R. do Guaiá, 51 — Perequê, Ilhabela - SP, 11630-000</div>
          </div>
          <div class="h-dist">290 m</div>
        </div>

        <div class="hotel">
          <div>
            <div class="h-name">Barra do Piuva Porto Hotel</div>
            <div class="h-addr">Av. Brasil, 1140 — Piúva, Ilhabela - SP, 11630-000</div>
          </div>
          <div class="h-dist">2,9 km</div>
        </div>

        <div class="hotel">
          <div>
            <div class="h-name">Hotel Ilhabela</div>
            <div class="h-addr">Av. Pedro de Paula Moraes, 151 — Saco da Capela, Ilhabela - SP, 11630-000</div>
          </div>
          <div class="h-dist">4,5 km</div>
        </div>

        <div class="hotel">
          <div>
            <div class="h-name">Velinn Feiticeira Praia Hotel Ilhabela</div>
            <div class="h-addr">R. Helena Alves de Carvalho, 238 — Portinho, Ilhabela - SP, 11630-000</div>
          </div>
          <div class="h-dist">6,2 km</div>
        </div>

        <div class="hotel">
          <div>
            <div class="h-name">Pousada Montemar</div>
            <div class="h-addr">R. José J. da Silva, 281 — Itaguassu, Ilhabela - SP, 11633-826</div>
          </div>
          <div class="h-dist">2,6 km</div>
        </div>

      </div>
    </div>

    <div class="center-head" style="margin-top:40px;">
      <a href="#contato" class="btn gold">Solicitar contato</a>
    </div>
  </div>
</section>

<!-- ===================== FOOTER ===================== -->
<footer>
  <div class="footer-bottom">
    <div class="footer-col footer-col-left">
      <p class="copyright">Copyright © 2026 Espaço Mares — <br class="mobile-only">Todos os direitos reservados</p>
    </div>
    <div class="footer-col footer-col-center">
      <img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/logo-white_resultado.webp" alt="Espaço Mares" class="client-logo" />
    </div>
    <div class="footer-col footer-col-right">
      <div class="developed-by">
        <span>Desenvolvido por</span>
        <a href="https://dmove.com.br" target="_blank" rel="noopener noreferrer" class="dmove-link">
          <img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/Logotipo-dmovepng.webp" alt="Dmove" class="dmove-logo" />
        </a>
      </div>
    </div>
  </div>
</footer>


  <WhatsAppModal
    step1Fields={waStep1Fields}
    welcomeMessage={"Olá! Quer realizar o seu casamento no Espaço Mares?\nPreencha os dados abaixo e fale conosco diretamente pelo WhatsApp."}
  />
</Base>
<script>
  import '../scripts/casamentos.js';
</script>
