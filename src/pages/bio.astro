---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import LeadForm from '../components/forms/LeadForm.astro';
import WhatsAppModal from '../components/layout/WhatsAppModal.astro';
import '../styles/casamentos.css';

const bioTipoOptions = [
  { value: '', label: 'Selecione' },
  { value: 'Aniversário', label: 'Aniversário' },
  { value: 'Aniversário debutante', label: 'Aniversário debutante' },
  { value: 'Bodas', label: 'Bodas' },
  { value: 'Casamento', label: 'Casamento' },
  { value: 'Confraternização corporativa', label: 'Confraternização corporativa' },
  { value: 'Confraternização social', label: 'Confraternização social' },
  { value: 'Corporativo', label: 'Corporativo' },
  { value: 'Feiras e Exposições', label: 'Feiras e Exposições' },
  { value: 'Formatura', label: 'Formatura' },
  { value: 'Happy Hours', label: 'Happy Hours' },
  { value: 'Masterclass e Palestras', label: 'Masterclass e Palestras' },
  { value: 'Mentorias e Treinamentos', label: 'Mentorias e Treinamentos' },
  { value: 'Offsite corporativo', label: 'Offsite corporativo' },
  { value: 'Reuniões de Networking', label: 'Reuniões de Networking' },
  { value: 'Shows e Festivais', label: 'Shows e Festivais' },
  { value: 'Workshops, Conferências e Seminários', label: 'Workshops, Conferências e Seminários' },
  { value: 'Outros', label: 'Outros' }
];

const waStep1Fields = [
  { name: 'tipo_evento', type: 'select', label: 'Tipo de Evento', required: true, options: bioTipoOptions },
  { name: 'convidados', type: 'number', label: 'Número de Convidados', min: '1', required: true },
  { name: 'data_prevista', type: 'date', label: 'Data Prevista', required: true, min: '2024-01-01' },
  { name: 'mensagem', type: 'textarea', label: 'Mensagem (Opcional)', required: false, rows: 3, placeholder: 'Conte-nos um pouco sobre como imagina o seu evento...' },
];
---

<Base
  title="Espaço Mares | Eventos e Comemorações em Ilhabela"
  description="A beleza natural de Ilhabela como cenário da sua comemoração. Celebre de frente para o mar no Espaço Mares."
  ogImage="https://media.dmove.com.br/clients/mares-ilha-bela/photos/fundo-bio.webp"
>
  <!-- ===================== CONTATO BIO (SINGLE COLUMN) ===================== -->
  <section id="contato" class="reveal bio-single-col">
    <img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/fundo-bio.webp" alt="Fundo Espaço Mares Ilhabela" class="bg" />

    <div class="wrap bio-wrap">
      <div class="bio-header-content">
        <div class="bio-logo-wrapper">
          <img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/logo-white_resultado.webp" alt="Espaço Mares" class="bio-logo" />
        </div>
        <h1>A beleza natural de<br>Ilhabela como cenário da<br><em>sua comemoração.</em></h1>
        <p class="lead">Celebre de frente para o mar e transforme<br class="desktop-only"> seu evento em algo único.</p>

        <div class="bio-address-wrapper">
          <a href="https://maps.google.com/?q=Av.+S%C3%A3o+Jo%C3%A3o,+492+-+Perequ%C3%AA,+Ilhabela+-+SP,+11633-036" target="_blank" rel="noopener noreferrer" class="btn-address">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.4"/></svg>
            <span>Endereço</span>
          </a>
        </div>
      </div>

      <div class="contato-form bio-form-card">
        <LeadForm
          formId="lead-form"
          prefix="wedding"
          project={config.project_slug}
          submitUrl={config.forms['lead-form'].webhooks[0]}
          redirectUrl={config.forms['lead-form'].redirect_on_success}
          submitText="Enviar solicitação"
          honeypot
          fields={[
            { name: 'nome', type: 'text', label: 'Nome', required: true, full: true },
            { name: 'telefone', type: 'tel', label: 'Telefone', required: true },
            { name: 'email', type: 'email', label: 'E-mail', required: true },
            { name: 'data', type: 'date', label: 'Data do evento', required: false },
            { name: 'pessoas', type: 'number', label: 'Número de pessoas', min: '1', required: false },
            { name: 'tipo', type: 'select', label: 'Tipo de evento', required: false, full: true, options: bioTipoOptions },
            { name: 'detalhes', type: 'textarea', label: 'Detalhes adicionais', rows: 4, required: false, full: true }
          ]}
        />
      </div>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer>
    <div class="footer-bottom">
      <div class="footer-col footer-col-left">
        <p class="copyright">Copyright © 2026 Espaço Mares — <br class="mobile-only">Todos os direitos reservados</p>
      </div>
      <div class="footer-col footer-col-center">
        <img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/logo-white_resultado.webp" alt="Espaço Mares" class="client-logo" />
      </div>
      <div class="footer-col footer-col-right">
        <div class="developed-by">
          <span>Desenvolvido por</span>
          <a href="https://dmove.com.br" target="_blank" rel="noopener noreferrer" class="dmove-link">
            <img src="https://media.dmove.com.br/clients/mares-ilha-bela/photos/Logotipo-dmovepng.webp" alt="Dmove" class="dmove-logo" />
          </a>
        </div>
      </div>
    </div>
  </footer>

  <WhatsAppModal
    step1Fields={waStep1Fields}
    welcomeMessage={"Olá! Quer realizar o seu evento no Espaço Mares?\nPreencha os dados abaixo e fale conosco diretamente pelo WhatsApp."}
  />
</Base>

<script>
  import '../scripts/casamentos.js';
</script>

<style>
  .bio-single-col {
    position: relative;
    padding: 60px 0 90px;
    background: var(--navy);
  }
  .bio-wrap {
    max-width: 580px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .bio-header-content {
    text-align: center;
    margin-bottom: 44px;
    width: 100%;
  }
  .bio-logo-wrapper {
    margin-top: 10px;
    margin-bottom: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0 40px;
    box-sizing: border-box;
  }
  .bio-logo {
    height: 86px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }
  .bio-header-content h1 {
    font-size: 2.2rem;
    line-height: 1.08;
    color: var(--white);
    font-weight: 300;
    margin-bottom: 18px;
  }
  .bio-header-content h1 em {
    font-style: italic;
    color: var(--gold-light);
  }
  .bio-header-content .lead {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.85);
    margin: 0 auto 28px;
    line-height: 1.5;
    max-width: 540px;
  }
  .bio-address-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 20px;
    width: 100%;
  }
  .btn-address {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: rgba(255,255,255,0.92);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 15px 24px;
    width: 100%;
    box-sizing: border-box;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 50px;
    transition: all 0.3s ease;
  }
  .btn-address:hover {
    color: var(--gold);
    border-color: var(--gold);
    background: rgba(255,255,255,0.12);
  }
  .btn-address svg {
    width: 18px;
    height: 18px;
    stroke: var(--gold);
    flex-shrink: 0;
  }
  .bio-form-card {
    width: 100%;
  }

  @media (max-width: 768px) {
    .bio-single-col {
      padding: 40px 0 60px;
    }
    .bio-header-content h1 {
      font-size: 1.7rem;
    }
    .bio-header-content .lead {
      font-size: 0.96rem;
    }
    .bio-logo-wrapper {
      margin-bottom: 36px;
    }
    .bio-logo {
      height: 72px;
    }
    .btn-address {
      font-size: 0.82rem;
      padding: 10px 16px;
    }
  }
</style>
