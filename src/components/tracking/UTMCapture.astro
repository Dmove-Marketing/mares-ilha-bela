<script>
  (function() {
    const params = new URLSearchParams(window.location.search);

    const utmKeys = [
      'utm_source', 'utm_medium', 'utm_campaign',
      'utm_content', 'utm_term'
    ];

    const clickIdKeys = ['gclid', 'fbclid', 'sck', 'ttclid', 'msclkid'];

    const trackingData: Record<string, string> = {};

    utmKeys.forEach(key => {
      const value = params.get(key);
      if (value) trackingData[key] = value;
    });

    clickIdKeys.forEach(key => {
      const value = params.get(key);
      if (value) trackingData[key] = value;
    });

    if (document.referrer && !document.referrer.includes(window.location.hostname)) {
      trackingData['referrer'] = document.referrer;
    }

    trackingData['landing_page'] = window.location.pathname;
    trackingData['landing_url'] = window.location.href.split('?')[0];

    if (!sessionStorage.getItem('dmove_first_visit')) {
      sessionStorage.setItem('dmove_first_visit', new Date().toISOString());
    }

    const hasNewParams = utmKeys.some(k => trackingData[k]) || clickIdKeys.some(k => trackingData[k]);
    if (hasNewParams) {
      sessionStorage.setItem('dmove_tracking', JSON.stringify(trackingData));
    }

    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({
      event: 'page_meta',
      page_path: window.location.pathname,
      ...trackingData
    });

    // Injeta automaticamente os campos ocultos de UTM e parâmetros de rastreamento nos formulários
    function injectFormTracking() {
      const forms = document.querySelectorAll<HTMLFormElement>('form');
      if (!forms.length) return;

      const urlParams = new URLSearchParams(window.location.search);
      const storedRaw = sessionStorage.getItem('dmove_tracking');
      const stored: Record<string, string> = storedRaw ? JSON.parse(storedRaw) : {};

      const fullUrl = window.location.href;
      const pathName = window.location.pathname;
      const searchParams = window.location.search;

      const dataToInject: Record<string, string> = {
        "utm_source": urlParams.get('utm_source') || stored['utm_source'] || '',
        "utm_medium": urlParams.get('utm_medium') || stored['utm_medium'] || '',
        "utm_campaign": urlParams.get('utm_campaign') || stored['utm_campaign'] || '',
        "utm_content": urlParams.get('utm_content') || stored['utm_content'] || '',
        "utm_term": urlParams.get('utm_term') || stored['utm_term'] || '',
        "fbclid": urlParams.get('fbclid') || stored['fbclid'] || '',
        "landing_page": pathName,
        "landing_url": fullUrl,
        "URL da página": fullUrl,
        "Fonte": `Landing page${pathName}${searchParams}`
      };

      forms.forEach(form => {
        Object.keys(dataToInject).forEach(key => {
          let input = form.querySelector<HTMLInputElement>(`input[name="${key}"]`);
          if (!input) {
            input = document.createElement("input");
            input.type = "hidden";
            input.name = key;
            form.appendChild(input);
          }
          input.value = dataToInject[key];
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', injectFormTracking);
    } else {
      injectFormTracking();
    }
  })();
</script>
